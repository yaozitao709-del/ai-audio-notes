{
  "name": "local-audio-minutes",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "test": "node --test src/*.test.js",
    "test:asr": "node --test --test-concurrency=1 server/*.test.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/launcher.mjs start",
    "stop": "node scripts/launcher.mjs stop",
    "setup:models": "node scripts/download-models.mjs",
    "bundle:server": "node scripts/bundle-server.mjs",
    "setup:speakers": "node scripts/download-speaker-models.mjs",
    "test:installer": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sherpa-onnx-node": "1.13.3",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "description": "Local Chinese/English transcription with information-preserving AI proofreading and meeting summaries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaozitao709-del/ai-audio-notes.git"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.13.3",
    "sherpa-onnx-win-x64": "1.13.3"
  }
}
