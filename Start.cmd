@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "AI_AUDIO_APP_ROOT=%~dp0"
set "AI_AUDIO_ACTION=start"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; try { $root=$env:AI_AUDIO_APP_ROOT; Set-Location -LiteralPath $root; if(-not [Environment]::Is64BitOperatingSystem -or $env:PROCESSOR_ARCHITECTURE -ne 'AMD64' -or [Environment]::OSVersion.Version.Build -lt 19041){throw 'Windows 10 (2004+) / 11 x64 is required.'}; $data=if($env:AI_AUDIO_DATA_ROOT){$env:AI_AUDIO_DATA_ROOT}else{Join-Path $env:LOCALAPPDATA 'AI Audio Notes'}; $cache=if($env:AI_AUDIO_CACHE_DIR){$env:AI_AUDIO_CACHE_DIR}else{Join-Path $data 'runtime-cache'}; $cached=Join-Path $cache 'node-v26.11.1-win-x64\node.exe'; $candidates=@($env:AI_AUDIO_NODE,(Join-Path $root 'runtime\node.exe'),$cached); $found=Get-Command node.exe -ErrorAction SilentlyContinue; if($found){$candidates+=$found.Source}; $node=$null; foreach($candidate in $candidates){if($candidate -and (Test-Path -LiteralPath $candidate)){try{$v=& $candidate --version; $a=& $candidate -p process.arch; $p=& $candidate -p process.platform; if($LASTEXITCODE -eq 0 -and $a -eq 'x64' -and $p -eq 'win32' -and [int](($v -replace '^v','').Split('.')[0]) -ge 26){$node=$candidate; break}}catch{}}}; if(-not $node){if($env:AI_AUDIO_ACTION -eq 'stop'){Write-Host 'No installed runtime; nothing to stop.'; exit 0}; New-Item -ItemType Directory -Force -Path $cache | Out-Null; $manifest=Get-Content -LiteralPath (Join-Path $root 'LITE_RUNTIME_MANIFEST.windows-x64.json') -Raw | ConvertFrom-Json; $zip=Join-Path $cache 'node-v26.11.1-win-x64.zip'; if(-not (Test-Path -LiteralPath $zip) -or (Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash -ne $manifest.node.sha256){Write-Host 'Downloading missing Node.js runtime...'; $partial=$zip+'.partial'; & (Join-Path $env:SystemRoot 'System32\curl.exe') --disable --fail --location --retry 2 --connect-timeout 20 --max-time 600 --proto '=https' --proto-redir '=https' $manifest.node.url --output $partial; if($LASTEXITCODE -ne 0){throw 'Node.js download failed; run again to retry.'}; if((Get-FileHash -LiteralPath $partial -Algorithm SHA256).Hash -ne $manifest.node.sha256){Remove-Item -LiteralPath $partial; throw 'Node.js checksum mismatch.'}; Move-Item -LiteralPath $partial -Destination $zip -Force}; Expand-Archive -LiteralPath $zip -DestinationPath $cache -Force; $node=$cached}; $env:PYTHONUTF8='1'; $env:PYTHONIOENCODING='utf-8'; $bundle=Get-Content -LiteralPath (Join-Path $root 'BUNDLED_SERVER.json') -Raw | ConvertFrom-Json; $entry=if($bundle.distribution -eq 'full'){'scripts\launcher.mjs'}else{'scripts\lite-setup.mjs'}; & $node (Join-Path $root $entry) $env:AI_AUDIO_ACTION; exit $LASTEXITCODE } catch { Write-Host $_.Exception.Message -ForegroundColor Red; exit 1 }"
set "AI_AUDIO_EXIT=%ERRORLEVEL%"
if not "%AI_AUDIO_NO_PAUSE%"=="1" if not "%AI_AUDIO_EXIT%"=="0" pause
exit /b %AI_AUDIO_EXIT%
